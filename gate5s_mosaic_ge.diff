+  for (int l = 0; l < kLayers; l++)
+    any |= g_mos[l].on;
+  if (!any)
+    return;
+  sceGuEnable(GU_DEPTH_TEST);
+  sceGuDepthMask(GU_TRUE);
+  sceGuDepthFunc(GU_ALWAYS);
+  sceGuEnable(GU_STENCIL_TEST);
